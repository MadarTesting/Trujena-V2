{
  "name": "trujina-automation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:lifecycle": "playwright test --grep @lifecycle",
    "test:design": "playwright test --grep @design",
    "test:plugins": "playwright test --grep @plugins",
    "test:notifications": "playwright test --grep @notifications",
    "test:support": "playwright test --grep @support",
    "test:subscription": "playwright test --grep @subscription",
    "test:profile": "playwright test --grep @profile",
    "test:logout": "playwright test --grep @logout",
    "test:customers": "playwright test --grep @customers",
    "test:orders": "playwright test --grep @orders",
    "test:admin-notifications": "playwright test --grep @adminNotifications",
    "test:admin-support": "playwright test --grep @adminSupport",
    "test:activity-log": "playwright test --grep @adminActivityLog",
    "test:roles": "playwright test --grep @adminRoles",
    "test:users": "playwright test --grep @adminUsers",
    "test:admin-profile": "playwright test --grep @adminProfile",
    "test:admin-logout": "playwright test --grep @adminLogout",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.5"
  }
